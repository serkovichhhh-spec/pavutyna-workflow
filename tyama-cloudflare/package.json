{
  "name": "tyama-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test:migration": "node ./scripts/test-migration-adapter.mjs",
    "test:e2e": "node ./scripts/smoke-local.mjs",
    "test": "npm run test:migration && npm run test:e2e",
    "check": "npm run types && npm run typecheck && npm test && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply tyama-core --local",
    "db:migrate:remote": "wrangler d1 migrations apply tyama-core --remote",
    "bootstrap:remote": "node ./scripts/bootstrap-remote.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  }
}
